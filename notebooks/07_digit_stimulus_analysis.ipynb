    }
   ],
   "source": [
    "F = extract_fingerprint_matrix(tree_root, np.arange(n_samples))\n",
    "expected_dim = sum(len(e['lambdas']) for e in tree_nodes)\n",
    "print(f'Fingerprint matrix: {F.shape}   (Σ K_i = {expected_dim})')\n",
    "assert F.shape[1] == expected_dim"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "similarity-heatmap",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 600x520 with 2 Axes>"
